# Copy this file to .env and replace both password placeholders before starting MySQL.
# Keep values unquoted and avoid whitespace, #, $, backticks, and quote characters;
# this restricted dotenv subset has identical Compose and PowerShell semantics.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

DB_HOST=127.0.0.1
DB_PORT=13307
DB_NAME=order_api
DB_USER=order_app
DB_PASSWORD=replace-with-a-local-app-password
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_READ_TIMEOUT=3s
DB_WRITE_TIMEOUT=3s
DB_QUERY_TIMEOUT=2s

HTTP_ADDR=127.0.0.1:28080
DIAGNOSTICS_ENABLED=false
TRANSACTION_DIAGNOSTICS_ENABLED=false
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
